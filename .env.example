# ============================================================
# Configuração do projeto — copie para .env e ajuste
#   cp .env.example .env
# Todas as variáveis do pipeline vivem aqui (100% via .env).
# .env é ignorado pelo git; este arquivo é o template.
# ============================================================

# Spark
spark.master=local[*]
spark.app.name=DataLakehouseMedallion
spark.sql.shuffle.partitions=4
spark.driver.memory=2g
spark.executor.memory=2g

# Delta Lake
spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension
spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog

# Delta Lake - Performance
spark.databricks.delta.schema.autoMerge.enabled=true
spark.databricks.delta.optimizeWrite.enabled=true
spark.databricks.delta.retentionDurationCheck.enabled=false

# MinIO / S3 (warehouse é definido em src/session.py conforme USE_MINIO)
spark.hadoop.fs.s3a.endpoint=http://localhost:9000
spark.hadoop.fs.s3a.access.key=minioadmin
spark.hadoop.fs.s3a.secret.key=minioadmin
spark.hadoop.fs.s3a.path.style.access=true
spark.hadoop.fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.connection.ssl.enabled=false
spark.hadoop.fs.s3a.aws.credentials.provider=org.apache.hadoop.fs.s3a.SimpleAWSCredentialsProvider

# Projeto (src/session.py)
USE_MINIO=true
MINIO_BUCKET=lake

# ============================================================
# Airflow / infraestrutura (docker-compose) — obrigatório para
# `podman-compose up` em repo público
# ============================================================
# O compose FALHA se AIRFLOW_FERNET_KEY não estiver definida (proposital:
# nada de chave de criptografia versionada no git). Gere uma chave nova:
#   python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=

# Senhas locais — se ausentes, o compose usa os defaults de demo abaixo.
# Repo público: defaults valem SÓ para ambiente local; troque antes de
# expor a stack em qualquer rede além do seu host.
# POSTGRES_PASSWORD=airflow
# AIRFLOW_ADMIN_PASSWORD=admin
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# (Se alterar MINIO_ROOT_*, mantenha spark.hadoop.fs.s3a.access.key/secret.key acima em sincronia.)

# JARs (Delta + hadoop-aws) são adicionados por src/session.py via spark.jars.packages
# spark.sql.warehouse.dir é definido por src/session.py:
#   local -> ./spark-warehouse | USE_MINIO=true -> s3a://lake/warehouse
